#!/usr/bin/env bash

set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/mlx"
pid_file="$state_dir/server.pid"
log_file="$state_dir/server.log"
host="${MLX_HOST:-127.0.0.1}"
port="${MLX_PORT:-13306}"
health_url="http://${host}:${port}/health"

if curl -fsS "$health_url" >/dev/null 2>&1; then
  echo "MLX server is already running at http://${host}:${port}/v1"
  exit 0
fi

mkdir -p "$state_dir"

if [[ -f "$pid_file" ]]; then
  pid="$(sed -n '1p' "$pid_file")"
  case "$pid" in
    ''|*[!0-9]*) ;;
    *)
      if kill -0 "$pid" 2>/dev/null; then
        echo "Error: MLX server process $pid is running but not healthy; see $log_file" >&2
        exit 1
      fi
      ;;
  esac
  rm -f "$pid_file"
fi

echo "Starting MLX server; first load can take a minute"
nohup mlx-server >"$log_file" 2>&1 &
pid=$!
printf '%s\n' "$pid" >"$pid_file"

attempt=0
while ((attempt < 180)); do
  if curl -fsS "$health_url" >/dev/null 2>&1; then
    echo "MLX server is ready at http://${host}:${port}/v1"
    exit 0
  fi
  if ! kill -0 "$pid" 2>/dev/null; then
    echo "Error: MLX server exited during startup; see $log_file" >&2
    exit 1
  fi
  sleep 1
  ((attempt += 1))
done

echo "Error: MLX server did not become ready; see $log_file" >&2
exit 1
