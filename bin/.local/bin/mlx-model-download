#!/usr/bin/env bash

set -euo pipefail

venv_dir="${XDG_DATA_HOME:-$HOME/.local/share}/venvs/mlx"
model_file="$(dirname "$0")/../share/mlx/model.txt"

if [[ ! -x "$venv_dir/bin/hf" ]]; then
  echo "Error: MLX is not installed; run mlx-setup" >&2
  exit 1
fi

if [[ ! -s "$model_file" ]]; then
  echo "Error: model configuration not found at $model_file" >&2
  exit 1
fi

model="$(sed -n '1p' "$model_file")"
echo "Downloading $model"
"$venv_dir/bin/hf" download "$model"
