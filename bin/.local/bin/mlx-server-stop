#!/usr/bin/env bash

set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/mlx"
pid_file="$state_dir/server.pid"

if [[ ! -f "$pid_file" ]]; then
  echo "MLX server is not running"
  exit 0
fi

pid="$(sed -n '1p' "$pid_file")"
case "$pid" in
  ''|*[!0-9]*)
    echo "Error: invalid MLX server PID file: $pid_file" >&2
    exit 1
    ;;
esac

if ! kill -0 "$pid" 2>/dev/null; then
  rm -f "$pid_file"
  echo "MLX server is not running"
  exit 0
fi

command_line="$(ps -p "$pid" -o command=)"
case "$command_line" in
  *"/venvs/mlx/bin/mlx_lm server"*) ;;
  *)
    echo "Error: refusing to stop unrelated process $pid: $command_line" >&2
    exit 1
    ;;
esac

kill "$pid"
attempt=0
while kill -0 "$pid" 2>/dev/null && ((attempt < 10)); do
  sleep 1
  ((attempt += 1))
done

if kill -0 "$pid" 2>/dev/null; then
  echo "Error: MLX server $pid did not stop" >&2
  exit 1
fi

rm -f "$pid_file"
echo "MLX server stopped"
