#!/usr/bin/env bash

set -euo pipefail

venv_dir="${XDG_DATA_HOME:-$HOME/.local/share}/venvs/mlx"
model_file="$(dirname "$0")/../share/mlx/model.txt"

if [[ ! -x "$venv_dir/bin/mlx_lm" ]]; then
  echo "Error: MLX LM is not installed; run mlx-setup" >&2
  exit 1
fi

if [[ ! -s "$model_file" ]]; then
  echo "Error: model configuration not found at $model_file" >&2
  exit 1
fi

model="${MLX_MODEL:-$(sed -n '1p' "$model_file")}"
host="${MLX_HOST:-127.0.0.1}"
port="${MLX_PORT:-13306}"

exec "$venv_dir/bin/mlx_lm" server \
  --model "$model" \
  --host "$host" \
  --port "$port" \
  --temp 1.0 \
  --top-p 0.95 \
  --top-k 40 \
  --max-tokens 16384 \
  --prompt-cache-size 2 \
  --prompt-cache-bytes 17179869184 \
  "$@"
