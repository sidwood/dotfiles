#!/usr/bin/env bash

set -euo pipefail

opencode_bin="$(command -v opencode || true)"
if [[ -z "$opencode_bin" ]]; then
  echo 'opencode-local: OpenCode is not installed or not on PATH' >&2
  exit 1
fi

for arg in "$@"; do
  case "$arg" in
    --) break ;;
    --help|-h|--version|-v) exec "$opencode_bin" "$@" ;;
  esac
done

case "${1:-}" in
  models|debug|auth|session|export|import|upgrade|uninstall|completion)
    exec "$opencode_bin" "$@"
    ;;
esac

# Custom configs own their endpoint checks as well as their model selection.
if [[ -z "${OPENCODE_CONFIG:-}${OPENCODE_CONFIG_CONTENT:-}" ]]; then
  if ! curl --fail --silent --max-time 3 http://127.0.0.1:1234/v1/models >/dev/null; then
    echo 'opencode-local: LM Studio is unavailable at http://127.0.0.1:1234/v1' >&2
    echo 'Start it with: lms server start --port 1234' >&2
    exit 1
  fi
fi

exec "$opencode_bin" "$@"
