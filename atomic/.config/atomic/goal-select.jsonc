// goal-select: the three dials.
//
// A launch chooses a writer model and a review tier; the orchestrator comes
// from defaults unless the launch sets it. The file is read again before
// every turn, so an edit applies to running work.
//
// Precedence, highest first: a top-level model key in this file or in a
// project policy file (an override for every run that reads it), the launch
// inputs, the chosen review tier, then defaults.
{
  "defaults": {
    "orchestrator_model": "openai/gpt-6.1-sol:medium",
    // Findings are re-verified on Astra whatever the tier. Left unset, the
    // re-verifier is the launching session's model, which is Sol here, and
    // Sol would then weigh findings against work a Sol writer wrote. No
    // tier has an Astra writer.
    "reverify_model": "openai/gpt-6-astra:high",
    "review_tier": "complex"
  },
  "review_tiers": {
    // One reviewer owning contract, evidence and risk together.
    "simple": {
      "panel": 1,
      "reviewer_model": "openai/gpt-6.1-sol:high",
      "max_turns": 3
    },
    // Completion-and-evidence on Sol, adversarial risk on Astra.
    "standard": {
      "panel": 2,
      "reviewer_model": "openai/gpt-6.1-sol:high",
      "risk_reviewer_model": "openai/gpt-6-astra:xhigh",
      "max_turns": 3
    },
    // The full three-role panel, quorum two of three.
    "complex": {
      "panel": 3,
      "reviewer_model": "openai/gpt-6-astra:high",
      "risk_reviewer_model": "openai/gpt-6-astra:xhigh",
      "max_turns": 3
    }
  }
}
