// goal-select: the three dials.
//
// A launch chooses a writer model and a review tier; the orchestrator comes
// from defaults unless the launch sets it. The file is read again before
// every turn, so an edit applies to running work. writer_fallbacks says
// where a writer goes when its provider fails.
//
// Precedence, highest first: a top-level model key in this file or in a
// project policy file (an override for every run that reads it), the launch
// inputs, the chosen review tier, then defaults.
//
// The fleet's presets (Sid, 2026-11-10). No OpenAI model: that subscription
// has lapsed. One reviewer in every tier, never on the writer's model line.
// This file is the preset where Opus 5.5 xhigh reviews:
//   simple:   Sonnet 5.5 xhigh writes
//   standard: GLM 5.3 max or Grok 4.7 xhigh writes
//   complex:  Fable 5.2 xhigh writes
// When Opus 5.5 xhigh writes (standard or complex), Sonnet 5.5 max reviews,
// which needs the atomic-fleet-manager skill's
// templates/policy-presets-opus-writer.jsonc instead of this file.
{
  "defaults": {
    "orchestrator_model": "anthropic/claude-sonnet-5-5:medium",
    // Findings are re-verified on the reviewer's line, which never writes
    // under this file.
    "reverify_model": "anthropic/claude-opus-5-5:high",
    "review_tier": "standard"
  },
  "review_tiers": {
    "simple": {
      "panel": 1,
      "reviewer_model": "anthropic/claude-opus-5-5:xhigh",
      "max_turns": 3
    },
    "standard": {
      "panel": 1,
      "reviewer_model": "anthropic/claude-opus-5-5:xhigh",
      "max_turns": 3
    },
    "complex": {
      "panel": 1,
      "reviewer_model": "anthropic/claude-opus-5-5:xhigh",
      "max_turns": 3
    }
  },
  // When a writer's provider fails (no credit, a usage limit, an outage) the
  // run moves the writer to the next model listed for its model line, in
  // order. A model on the chosen tier's review panel, or re-verifying its
  // findings, is passed over: a model line never reviews its own work. With
  // nothing left the run stops and can be resumed once the provider is put
  // right. Keys are provider/model without an effort. The GLM and Grok
  // chains are Sid's order of 2026-11-06. Sid has named no fallback for an
  // Anthropic writer.
  "writer_fallbacks": {
    "zai/glm-5.3": ["xai/grok-4.7:xhigh", "anthropic/claude-sonnet-5-5:xhigh"],
    "xai/grok-4.7": ["anthropic/claude-sonnet-5-5:xhigh"],
    "anthropic/claude-sonnet-5-5": [],
    "anthropic/claude-opus-5-5": []
  }
}
