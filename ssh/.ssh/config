# 1Password SSH agent
Match host * exec "test -e ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Framework Desktop LLM/API appliance
Host llm
    HostName 192.168.4.25
    User sidwood
    HostKeyAlias llm.home.arpa
    PreferredAuthentications publickey

# Framework Omarchy desktop over Tailscale
Host framework
    HostName 100.122.72.1
    User sidwood
    HostKeyAlias 192.168.4.26
    HostKeyAlgorithms ssh-ed25519
    StrictHostKeyChecking yes
    IdentityFile /Users/sidwood/Documents/Codex/Homelab/llm.home.arpa/framework-ssh.pub
    IdentitiesOnly yes
    PreferredAuthentications publickey

# Beelink Proxmox appliance
Host pve
    HostName pve.ladon-gopher.ts.net
    User sidwood
    HostKeyAlias pve.home.arpa
    IdentityFile ~/.ssh/pve.home.arpa.pub
    IdentitiesOnly yes
    PreferredAuthentications publickey
