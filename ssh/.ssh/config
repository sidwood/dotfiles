# 1Password SSH agent (Linux)
Match host * exec "test -e ~/.1password/agent.sock"
    IdentityAgent ~/.1password/agent.sock

# 1Password SSH agent (macOS)
Match host * exec "test -e ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Framework Desktop LLM/API appliance
Host llm
    HostName 192.168.4.25
    User sidwood
    HostKeyAlias llm.home.arpa
    PreferredAuthentications publickey

# Beelink Proxmox appliance
Host pve
    HostName 192.168.4.28
    User sidwood
    HostKeyAlias pve.home.arpa
    IdentityFile ~/.ssh/pve.home.arpa.pub
    IdentitiesOnly yes
    PreferredAuthentications publickey
