# 1Password SSH agent
Match host * exec "test -e ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Framework Omarchy desktop over Tailscale
Host framework
    HostName framework.ladon-gopher.ts.net
    User sidwood
    HostKeyAlias 192.168.4.26
    HostKeyAlgorithms ssh-ed25519
    StrictHostKeyChecking yes
    IdentityFile ~/.ssh/framework.pub
    IdentitiesOnly yes
    PreferredAuthentications publickey

# Beelink Proxmox appliance
Host pve
    HostName pve.ladon-gopher.ts.net
    User sidwood
    HostKeyAlias pve.home.arpa
    IdentityFile ~/.ssh/pve.home.arpa.pub
    IdentitiesOnly yes
    PreferredAuthentications publickey

