# Unified shell init (sourced by zsh)
# Tool integrations

export OPENCODE_ENABLE_EXA=1
export OPENCODE_EXPERIMENTAL_LSP_TOOL=1
export OPENCODE_ENABLE_QUESTION_TOOL=1
export OPENCODE_EXPERIMENTAL_PLAN_MODE=1

# ------------------------------------------------------------------------------
# mise (version manager for node, python, ruby, etc.)
# ------------------------------------------------------------------------------

if command -v mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi

# ------------------------------------------------------------------------------
# zoxide (smart cd)
# ------------------------------------------------------------------------------

if command -v zoxide &>/dev/null; then
  eval "$(zoxide init --cmd cd zsh)"
fi

# ------------------------------------------------------------------------------
# fzf (fuzzy finder)
# ------------------------------------------------------------------------------

if command -v fzf &>/dev/null; then
  eval "$(fzf --zsh)"
fi

# ------------------------------------------------------------------------------
# direnv (per-directory environment)
# ------------------------------------------------------------------------------

if command -v direnv &>/dev/null; then
  eval "$(direnv hook zsh)"
fi

# ------------------------------------------------------------------------------
# local environment variables (machine-specific, not committed)
# ------------------------------------------------------------------------------

if [[ -f "$HOME/.config/shell/local.env" ]]; then
  . "$HOME/.config/shell/local.env"
fi
