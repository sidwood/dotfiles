# Unified shell functions (sourced by both bash and zsh)

# ------------------------------------------------------------------------------
# Directory operations
# ------------------------------------------------------------------------------

# Create directory and cd into it
mkcd() {
  mkdir -p "$1" && cd "$1"
}

# Pick a git branch clone with fzf and cd into it. Extra arguments pass through
# to git-bc-list, so `gbcd ~/code` scans elsewhere and `gbcd -a` includes base
# clones. A function rather than an alias because only the shell itself can cd.
if command -v fzf &>/dev/null && command -v git-bc-list &>/dev/null; then
  gbcd() {
    local dir
    dir="$(git-bc-list --paths "$@" | fzf --no-multi \
      --preview 'git -C {} status --short --branch' \
      --preview-window=right,50%)" || return
    [[ -n "$dir" ]] || return
    cd "$dir" || return
  }
fi

# ------------------------------------------------------------------------------
# File operations
# ------------------------------------------------------------------------------

# Extract various archive formats
extract() {
  if [[ -f "$1" ]]; then
    case "$1" in
      *.tar.bz2) tar xjf "$1" ;;
      *.tar.gz)  tar xzf "$1" ;;
      *.tar.xz)  tar xJf "$1" ;;
      *.bz2)     bunzip2 "$1" ;;
      *.gz)      gunzip "$1" ;;
      *.tar)     tar xf "$1" ;;
      *.tbz2)    tar xjf "$1" ;;
      *.tgz)     tar xzf "$1" ;;
      *.zip)     unzip "$1" ;;
      *.Z)       uncompress "$1" ;;
      *.7z)      7z x "$1" ;;
      *)         echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}
