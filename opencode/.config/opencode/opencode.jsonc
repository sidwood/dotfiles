{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "mlx/default_model",
  "provider": {
    "framework": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Framework Desktop",
      "options": {
        "baseURL": "http://192.168.4.25:13305/v1",
        "apiKey": "{env:FRAMEWORK_LEMONADE_API_KEY}"
      },
      "models": {
        "Qwen3.5-122B-A10B-GGUF": {
          "name": "Qwen3.5-122B-A10B Q4 (Framework)",
          "reasoning": false,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 8192
          },
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          }
        }
      }
    },
    "mlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX on M5 Max",
      "options": {
        "baseURL": "http://127.0.0.1:13306/v1",
        "apiKey": "local"
      },
      "models": {
        "default_model": {
          "name": "Qwen3-Coder-Next 4-bit (M5 Max)",
          "limit": {
            "context": 65536,
            "output": 16384
          }
        }
      }
    },
    "mlx-qwen36": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX Qwen3.6 on M5 Max",
      "options": {
        "baseURL": "http://127.0.0.1:13307/v1",
        "apiKey": "local"
      },
      "models": {
        "default_model": {
          "name": "Qwen3.6 35B-A3B OptiQ 4-bit (M5 Max)",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "local"
      },
      "models": {
        "qwen/qwen3.8-27b": {
          "name": "Qwen3.8 27B (LM Studio)",
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "google/gemma-4-26b-a4b-qat": {
          "name": "Gemma 4 26B A4B QAT (LM Studio)",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      }
    }
  }
}
